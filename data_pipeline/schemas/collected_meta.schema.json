{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collected frame metadata",
  "type": "object",
  "required": ["frame", "timestamp", "frame_idx", "instruction", "episode", "teleop"],
  "properties": {
    "frame": {"type": "string"},
    "timestamp": {"type": "number"},
    "frame_idx": {"type": "integer"},
    "instruction": {"type": "string"},
    "episode": {"type": "string"},
    "teleop": {"type": "string"},
    "command": {"type": "string"},
    "motors": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 4,
      "maxItems": 4
    },
    "action": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    }
  }
}
